{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src", "scripts", "electron.vite.config.ts", "vite.config.ts"],
  "exclude": ["research", "node_modules", "out", "dist"]
}
