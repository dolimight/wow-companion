{
  "name": "wow-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A local Retail WoW character and gear companion",
  "author": "WOW Companion",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node --import tsx scripts/dev-desktop.ts",
    "dev:browser": "tsx scripts/dev-web.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "check": "npm run typecheck && vp test",
    "package:win": "electron-vite build && electron-builder --win --dir",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "test:desktop": "node --import tsx scripts/desktop-acceptance.ts",
    "test:debug": "node --import tsx scripts/debug-desktop.ts",
    "test:scripts": "node --import tsx --test scripts/*.test.ts scripts/release/*.test.ts",
    "icons": "node --import tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@trpc/server": "11.19.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.4",
    "electron-updater": "6.8.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "8.21.3",
    "@trpc/client": "11.19.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.5",
    "shadcn": "4.21.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "^0.186.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "@shadcn/react": "^0.3.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.8.0",
    "shiki": "^4.5.0"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "esbuild@0.28.2": true,
    "better-sqlite3": false
  }
}
