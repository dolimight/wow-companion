      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:550 12px/1.45 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;padding:7px 12px;min-height:32px;border-radius:7px;cursor:pointer;transition:background 100ms,color 100ms;background:transparent;color:var(--accent,#0065c7);border:0;padding-inline:0;}.ds-btn-quiet svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}.ds-btn-quiet:hover{text-decoration:underline}.ds-btn-quiet:focus-visible{outline:3px solid var(--accent,#0065c7);outline-offset:3px;}.ds-btn-quiet:active:not(:disabled){transform:scale(.98)}.ds-btn-quiet:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-quiet{transition:none;transform:none}}"
