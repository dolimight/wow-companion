      "refersTo": "search",
      "description": "A compact bordered search surface",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input aria-label=\"Search players\" placeholder=\"Find a player\"></label>",
      "css": ".ds-search{display:inline-flex;align-items:center;gap:7px;background:var(--surface,#fff);border:1px solid var(--line,#dde3eb);border-radius:7px;padding:6px 9px;color:var(--muted,#647184);min-width:150px;font:12px/1.45 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif}.ds-search svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}.ds-search input{border:0;background:none;width:130px;font:inherit;color:var(--ink,#1c2430);padding:1px;outline:0}.ds-search:hover{border-color:var(--secondary,#566374)}.ds-search input:focus-visible{outline:3px solid var(--accent,#0065c7);outline-offset:3px;}"
