      "html": "<button type=\"button\" class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 4 4L20 5\"/></svg>Save build</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:550 12px/1.45 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;padding:7px 12px;min-height:32px;border-radius:7px;cursor:pointer;transition:background 100ms,color 100ms;background:var(--accent,#0065c7);color:var(--on-accent,#fff);border:1px solid transparent;}.ds-btn-primary svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}.ds-btn-primary:hover{filter:brightness(.96)}.ds-btn-primary:focus-visible{outline:3px solid var(--accent,#0065c7);outline-offset:3px;}.ds-btn-primary:active:not(:disabled){transform:scale(.98)}.ds-btn-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none;transform:none}}"
