      "html": "<span class=\"ds-tag\">Frost Mage</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:5px;border-radius:5px;font:550 12px/1.4 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;padding:3px 6px;background:var(--accent-soft,#e4f0fd);color:var(--accent,#0065c7);white-space:nowrap}"
    },
    {
      "name": "Detail panel",
      "kind": "card",
      "refersTo": "detail-panel",
      "description": "A quiet comparison surface without an independent shadow",
      "html": "<section class=\"ds-detail\"><h2>Band of Frozen Echoes</h2><p>Ring 1 · Epic · Demo item</p><div class=\"ds-compare\"><span>Current item level</span><strong>262</strong></div><div class=\"ds-compare\"><span>Attainable target</span><strong class=\"ds-target\">281</strong></div></section>",
      "css": ".ds-detail{background:var(--surface,#fff);color:var(--ink,#1c2430);border-radius:12px;padding:20px;font:12px/1.45 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif}.ds-detail h2{font-size:18px;font-weight:650;line-height:1.3;letter-spacing:-.015em;margin:0 0 5px}.ds-detail p{color:var(--muted,#647184);margin:0}.ds-compare{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line,#dde3eb)}.ds-compare strong{font-variant-numeric:tabular-nums}.ds-target{color:var(--accent,#0065c7)}"
    },
    {
      "name": "Activity segments",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Separate activity context with a visible pressed state",
      "html": "<div class=\"ds-segments\" aria-label=\"Activity\"><button aria-pressed=\"true\">Mythic+</button><button aria-pressed=\"false\">Raiding</button><button aria-pressed=\"false\">PvP</button></div>",
      "css": ".ds-segments{display:inline-flex;padding:3px;background:var(--surface3,#e8ecf1);border-radius:8px;gap:2px}.ds-segments button{border:0;padding:5px 13px;border-radius:6px;color:var(--secondary,#566374);font:12px/1.45 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;background:transparent;white-space:nowrap;min-height:27px;cursor:pointer;transition:background 100ms,color 100ms}.ds-segments button[aria-pressed=true]{background:var(--surface,#fff);box-shadow:0 1px 4px rgba(20,38,60,.12);color:var(--ink,#1c2430);font-weight:600}.ds-segments button:hover{background:var(--surface2,#f0f2f5)}.ds-segments button:focus-visible{outline:3px solid var(--accent,#0065c7);outline-offset:3px;}.ds-segments button:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-segments button{transition:none;transform:none}}"
    }
  ],
  "narrative": {
    "northStar": "The character folio",
    "overview": "A calm desktop companion gives character identity and progression room to lead, with a persistent translucent sidebar, quiet silver separators, system typography, and blue selection. Apple design principles guide hierarchy, feedback, and material depth within an Electron-shaped shell and familiar shadcn-style controls\n\nThis system is extracted from the five-screen clickable HTML mock in plans/wow-companion/ui-mocks.html, covering Characters, Character, Gear planner, Standings, and Wardrobe. Home opens a roster of four fictional characters with a selected-character pane. The working name is provisional, all character and game values are fictional demo content, and only the mage has generated static concept artwork",
    "keyCharacteristics": [
      "Adaptive light and dark semantic surfaces with a single interaction accent",
      "Readable compact controls and tabular progression numbers",
      "Character imagery framed by consistent slot alignment",
      "Fast state feedback with reduced-motion and reduced-transparency alternatives"
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Use the blue accent to indicate navigation, a chosen item, or an available action; keep epic item purple, success green, and attention amber semantic",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use tabular numerals and consistent column alignment for item levels, deltas, rating, and rank",
        "section": "typography"
      },
      {
        "name": "The Material Rule",
        "body": "Reserve broad shadows for the app window, overlay sheet, and toast; use surface tone and separators inside the workspace",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the semantic light/dark token pairing and use on-accent for filled blue controls",
      "Do keep labels readable at the observed 12px minimum and align numeric comparisons",
      "Do label sample populations, snapshot age, and static concept artwork honestly",
      "Do keep design sources and assets local and use T3 Code's native planner",
      "Do omit trailing periods from user-facing UI copy and assistant replies",
      "Do name the source and age of every real number, and mark estimates as estimates",
      "Do answer a non-technical player's question in plain words: say \"Sync\", not \"SavedVariables\", and never ask for a file path",
      "Do show progress where the work was requested, with the control or heading that started it"
    ],
    "donts": [
      "Don't present fictional item levels, rankings, or season limits as current game facts",
      "Don't turn item-level changes into an invented combat-performance estimate",
      "Don't describe model inspection as a character builder; attached models never change with outfit choices",
      "Don't replace the chosen Apple-inspired world with an unrelated visual identity",
      "Don't draw custom window buttons, add a title bar border, or offer a native-frame option",
      "Don't use native select elements or checkbox inputs",
      "Don't show status that asks for no action, such as a count of stored characters",
      "Don't present an estimated Great Vault or a popularity count without its population and source",
      "Don't offer a manual file import as a first-line action"
    ]
  }
}
