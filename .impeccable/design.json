      "css": ".ds-nav{display:flex;align-items:center;gap:10px;text-align:left;background:var(--accent,#0065c7);color:var(--on-accent,#fff);border:0;padding:9px 10px;border-radius:7px;min-height:36px;font:500 13px/1.45 -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;cursor:pointer;transition:background 100ms,color 100ms}.ds-nav svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;width:17px;height:17px}.ds-nav:hover{background:var(--accent,#0065c7)}.ds-nav:focus-visible{outline:3px solid var(--accent,#0065c7);outline-offset:3px;}.ds-nav:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none;transform:none}}"
